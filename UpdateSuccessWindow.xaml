<Window x:Class="ETSOverlay.UpdateSuccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
        Title="Update Successful" Width="580" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True">

    <Window.Resources>
        <SolidColorBrush x:Key="DialogAccentBrush" Color="#43A047"/>
        <SolidColorBrush x:Key="DialogAccentHoverBrush" Color="#388E3C"/>
        <SolidColorBrush x:Key="DialogLinkBrush" Color="#58A6FF"/>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}" 
            BorderBrush="{DynamicResource CardBorderBrush}" 
            BorderThickness="1" 
            CornerRadius="12" 
            Padding="22" 
            Margin="15">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="25" Opacity="{DynamicResource ShadowOpacity}" Direction="270" ShadowDepth="5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleBlock" Text="UPDATE SUCCESSFUL" Foreground="{StaticResource DialogAccentBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock x:Name="ReleaseNameBlock" Foreground="{DynamicResource MainTextBrush}" FontSize="17" FontWeight="Bold" Margin="0,0,0,5" />
            </StackPanel>

            <TextBlock Grid.Row="2" x:Name="FallbackBlock" Foreground="{DynamicResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,5,0,20" />

            <md:MarkdownScrollViewer Grid.Row="2" x:Name="MarkdownViewer" 
                                     Foreground="{DynamicResource MainTextBrush}"
                                     Background="Transparent" 
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,15">
                <md:MarkdownScrollViewer.Resources>
                    <Style TargetType="List">
                        <Setter Property="MarkerStyle" Value="Disc" />
                    </Style>
                    <Style TargetType="ListItem">
                        <Setter Property="Margin" Value="0,2" />
                    </Style>
                </md:MarkdownScrollViewer.Resources>
                <md:MarkdownScrollViewer.Engine>
                    <md:Markdown>
                        <md:Markdown.Heading1Style>
                            <Style TargetType="Paragraph">
                                <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
                                <Setter Property="FontSize" Value="22" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Margin" Value="0,14,0,8" />
                            </Style>
                        </md:Markdown.Heading1Style>
                        <md:Markdown.Heading2Style>
                            <Style TargetType="Paragraph">
                                <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
                                <Setter Property="FontSize" Value="18" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Margin" Value="0,14,0,8" />
                            </Style>
                        </md:Markdown.Heading2Style>
                        <md:Markdown.Heading3Style>
                            <Style TargetType="Paragraph">
                                <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
                                <Setter Property="FontSize" Value="15" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Margin" Value="0,12,0,6" />
                            </Style>
                        </md:Markdown.Heading3Style>
                        <md:Markdown.Heading4Style>
                            <Style TargetType="Paragraph">
                                <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Margin" Value="0,10,0,4" />
                            </Style>
                        </md:Markdown.Heading4Style>
                        <md:Markdown.BlockquoteStyle>
                            <Style TargetType="Section">
                                <Setter Property="BorderThickness" Value="3,0,0,0" />
                                <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                <Setter Property="Padding" Value="12,8,12,8" />
                                <Setter Property="Margin" Value="0,6,0,10" />
                            </Style>
                        </md:Markdown.BlockquoteStyle>
                        <md:Markdown.CodeBlockStyle>
                            <Style TargetType="Paragraph">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="Padding" Value="10" />
                                <Setter Property="Margin" Value="0,5,0,12" />
                            </Style>
                        </md:Markdown.CodeBlockStyle>
                        <md:Markdown.CodeStyle>
                            <Style TargetType="Run">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
                                <Setter Property="FontFamily" Value="Consolas" />
                            </Style>
                        </md:Markdown.CodeStyle>
                        <md:Markdown.LinkStyle>
                            <Style TargetType="Hyperlink">
                                <Setter Property="Foreground" Value="{StaticResource DialogLinkBrush}" />
                                <Setter Property="TextDecorations" Value="None" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="TextDecorations" Value="Underline" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </md:Markdown.LinkStyle>
                    </md:Markdown>
                </md:MarkdownScrollViewer.Engine>
            </md:MarkdownScrollViewer>

            <Grid Grid.Row="3" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="SupportBlock" Text="Need help? Contact support@trucksim.uk" Foreground="{DynamicResource MutedTextBrush}" FontStyle="Italic" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                
                <StackPanel Grid.Column="1" x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnWebsite" Content="Website" Click="BtnWebsite_Click" Padding="14,0" Height="32" Margin="0,0,10,0" Cursor="Hand" Background="{StaticResource DialogAccentBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource DialogAccentHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnClose" Content="Close" Click="BtnClose_Click" Padding="18,0" Height="32" Cursor="Hand" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource MainTextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="#E81123"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
