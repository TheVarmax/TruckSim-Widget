<Window x:Class="ETSOverlay.UpdateSuccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
        Title="Update Successful" Width="560" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False">

    <Border Background="#1A1C20" CornerRadius="12" Padding="20" Margin="15">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.5" Direction="270" ShadowDepth="4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock x:Name="TitleBlock" Text="UPDATE SUCCESSFUL" Foreground="#43A047" FontSize="15" FontWeight="Bold" Margin="0,0,0,15"/>

            <StackPanel Grid.Row="1" Margin="0,5,0,10">
                <TextBlock x:Name="ReleaseNameBlock" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" />
            </StackPanel>

            <!-- Fallback text block -->
            <TextBlock Grid.Row="2" x:Name="FallbackBlock" Foreground="#A0A0A0" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,5,0,20" />

            <md:MarkdownScrollViewer Grid.Row="2" x:Name="MarkdownViewer" 
                                     Foreground="White"
                                     Background="Transparent" 
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,15">
                <md:MarkdownScrollViewer.Resources>
                    <Style TargetType="List">
                        <Setter Property="MarkerStyle" Value="Disc" />
                    </Style>
                    <Style TargetType="ListItem">
                        <Setter Property="Margin" Value="0,2" />
                    </Style>
                </md:MarkdownScrollViewer.Resources>
                <md:MarkdownScrollViewer.Engine>
                    <md:Markdown>
                        <md:Markdown.Heading1Style>
                            <Style TargetType="Paragraph">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontSize" Value="24" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Margin" Value="0,15,0,10" />
                            </Style>
                        </md:Markdown.Heading1Style>
                        <md:Markdown.Heading2Style>
                            <Style TargetType="Paragraph">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontSize" Value="20" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Margin" Value="0,15,0,10" />
                            </Style>
                        </md:Markdown.Heading2Style>
                        <md:Markdown.Heading3Style>
                            <Style TargetType="Paragraph">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontSize" Value="16" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Margin" Value="0,15,0,10" />
                            </Style>
                        </md:Markdown.Heading3Style>
                        <md:Markdown.Heading4Style>
                            <Style TargetType="Paragraph">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontSize" Value="14" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Margin" Value="0,10,0,5" />
                            </Style>
                        </md:Markdown.Heading4Style>
                        <md:Markdown.CodeBlockStyle>
                            <Style TargetType="Paragraph">
                                <Setter Property="Background" Value="#2b3137" />
                                <Setter Property="Foreground" Value="#E6EDF3" />
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="Padding" Value="10" />
                                <Setter Property="Margin" Value="0,5,0,15" />
                            </Style>
                        </md:Markdown.CodeBlockStyle>
                        <md:Markdown.CodeStyle>
                            <Style TargetType="Run">
                                <Setter Property="Background" Value="#2b3137" />
                                <Setter Property="Foreground" Value="#E6EDF3" />
                                <Setter Property="FontFamily" Value="Consolas" />
                            </Style>
                        </md:Markdown.CodeStyle>
                        <md:Markdown.LinkStyle>
                            <Style TargetType="Hyperlink">
                                <Setter Property="Foreground" Value="#4493F8" />
                                <Setter Property="TextDecorations" Value="None" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="TextDecorations" Value="Underline" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </md:Markdown.LinkStyle>
                    </md:Markdown>
                </md:MarkdownScrollViewer.Engine>
            </md:MarkdownScrollViewer>

            <Grid Grid.Row="3" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="SupportBlock" Text="Need help? Contact support@trucksim.uk" Foreground="#A0A0A0" FontStyle="Italic" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                
                <!-- Buttons -->
                <StackPanel Grid.Column="1" x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnWebsite" Content="Сайт проєкту" Click="BtnWebsite_Click" Padding="12,0" Height="30" Margin="0,0,10,0" Cursor="Hand" Background="#43A047" Foreground="White" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnClose" Content="Закрити" Click="BtnClose_Click" Padding="15,0" Height="30" Cursor="Hand" Background="#3A3D45" Foreground="White" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
