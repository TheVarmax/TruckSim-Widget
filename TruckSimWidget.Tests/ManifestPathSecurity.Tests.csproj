      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="ManifestPathSecurityTests.cs" />
    <Compile Include="InstallerTests.cs" />
    <Compile Include="PluginStagingIntegrityTests.cs" />
    <ProjectReference Include="..\TruckSimWidgetSetup\TruckSimWidgetSetup.csproj" />
    <ProjectReference Include="..\ElevatedHelper\ElevatedHelper.csproj" />
  </ItemGroup>

</Project>
