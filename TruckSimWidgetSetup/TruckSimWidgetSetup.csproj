<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>TruckSimWidgetSetup</RootNamespace>
    <AssemblyName>TruckSimWidgetSetup</AssemblyName>
    <Version>1.6.7</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>


  <ItemGroup>
    <Resource Include="favicon.ico" />
  </ItemGroup>

  <!-- Release publish receives generated resources from the Widget publish target. -->
  <ItemGroup>
    <EmbeddedResource Include="$(InstallerPayloadPath)" LogicalName="TruckSimWidgetSetup.Resources.payload.zip" Condition="'$(InstallerPayloadPath)' != '' and Exists('$(InstallerPayloadPath)')" />
    <EmbeddedResource Include="$(InstallerPluginPath)" LogicalName="TruckSimWidgetSetup.Resources.scs-telemetry.dll" Condition="'$(InstallerPluginPath)' != '' and Exists('$(InstallerPluginPath)')" />
  </ItemGroup>

  <Target Name="RequireInstallerPayload" BeforeTargets="PrepareForBuild;Publish">
    <Error Condition="'$(InstallerPayloadPath)' == '' or !Exists('$(InstallerPayloadPath)')" Text="Installer publish requires a generated payload.zip." />
    <Error Condition="'$(InstallerPluginPath)' == '' or !Exists('$(InstallerPluginPath)')" Text="Installer publish requires scs-telemetry.dll." />
  </Target>

</Project>
