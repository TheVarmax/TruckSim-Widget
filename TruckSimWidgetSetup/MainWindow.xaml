<Window x:Class="TruckSimWidgetSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TruckSimWidgetSetup.UI.ViewModels"
        mc:Ignorable="d"
        Title="TruckSim Widget Setup" Height="440" Width="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Icon="favicon.ico">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UI/Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BgMain}" BorderBrush="{StaticResource BgBorder}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <!-- Header -->
                <RowDefinition Height="*" />
                <!-- Content -->
                <RowDefinition Height="60" />
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent" MouseDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="🚛" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="TruckSim Widget Setup" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Content="—" Width="30" Height="26" Click="BtnMinimize_Click" Style="{StaticResource SecondaryButton}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextSecondary}" Margin="0,0,4,0" />
                    <Button Content="✕" Width="30" Height="26" Click="BtnClose_Click" Style="{StaticResource SecondaryButton}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
            </Grid>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="24,10,24,10">

                <!-- 1. Welcome View -->
                <StackPanel x:Name="WelcomePanel" Visibility="Collapsed">
                    <TextBlock Text="Welcome to TruckSim Widget Setup" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock Text="This wizard will install TruckSim Widget on your computer." Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,20" />

                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BgBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Package Information" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding PackageVersion, StringFormat='Version: {0}'}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBlock Text="Location: %LOCALAPPDATA%\Programs\TruckSim Widget" Foreground="{StaticResource TextSecondary}" />
                        </StackPanel>
                    </Border>

                    <CheckBox Content="Create a desktop shortcut" IsChecked="{Binding CreateDesktopShortcut}" Margin="0,0,0,10" />
                </StackPanel>

                <!-- 2. Manage View (Already Installed) -->
                <StackPanel x:Name="ManagePanel" Visibility="Collapsed">
                    <TextBlock Text="TruckSim Widget is Installed" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock Text="A valid installation was detected on your computer. Choose an action:" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,16" />

                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BgBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding InstalledVersion, StringFormat='Installed Version: {0}'}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding PackageVersion, StringFormat='Package Version: {0}'}" Foreground="{StaticResource Accent}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding InstallInfo.InstallPath, StringFormat='Path: {0}'}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Reinstall Current Version" Click="BtnReinstall_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" />
                        <Button Content="Update" Click="BtnUpdate_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" />
                        <Button Content="Uninstall" Click="BtnUninstall_Click" Style="{StaticResource DangerButton}" />
                    </StackPanel>
                </StackPanel>

                <!-- 3. Telemetry Selection View -->
                <StackPanel x:Name="TelemetrySelectionPanel" Visibility="Collapsed">
                    <TextBlock Text="Telemetry Plugin Setup" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock Text="TruckSim Widget requires scs-telemetry.dll inside each game's plugins folder. Select the games you want to configure:" Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,20" />

                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BgBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <CheckBox Content="Euro Truck Simulator 2" IsChecked="{Binding Ets2Config.UserSelected}" Margin="0,0,0,12" />
                            <CheckBox Content="American Truck Simulator" IsChecked="{Binding AtsConfig.UserSelected}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 4. Game Directories View -->
                <StackPanel x:Name="GameDirectoriesPanel" Visibility="Collapsed">
                    <TextBlock Text="Game Folders" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="Verify or choose the root folders of your installed games:" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,16" />

                    <!-- ETS2 -->
                    <StackPanel Visibility="{Binding Ets2Config.UserSelected, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                        <TextBlock Text="Euro Truck Simulator 2:" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Ets2Config.SelectedPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Browse..." Click="BtnBrowseEts2_Click" Style="{StaticResource SecondaryButton}" Height="32" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <!-- ATS -->
                    <StackPanel Visibility="{Binding AtsConfig.UserSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="American Truck Simulator:" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding AtsConfig.SelectedPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Browse..." Click="BtnBrowseAts_Click" Style="{StaticResource SecondaryButton}" Height="32" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- 5. Conflict Resolution View -->
                <StackPanel x:Name="ConflictResolutionPanel" Visibility="Collapsed">
                    <TextBlock Text="Plugin Conflict Resolution" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="An existing telemetry plugin was detected in one or more game folders. Choose how to handle it:" Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BgBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <RadioButton Content="Backup existing plugin and install TruckSim Widget plugin (Recommended)" IsChecked="True" Checked="RadioConflictBackup_Checked" Margin="0,0,0,10" />
                            <RadioButton Content="Keep existing plugin (skip Widget plugin for that game)" Checked="RadioConflictKeep_Checked" Margin="0,0,0,10" />
                            <RadioButton Content="Overwrite existing plugin without backup" Checked="RadioConflictOverwrite_Checked" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 6. Installing Progress View -->
                <StackPanel x:Name="InstallingPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Installing TruckSim Widget..." Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />
                    <ProgressBar Value="{Binding ProgressPercentage}" Height="10" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Accent}" FontSize="13" />
                </StackPanel>

                <!-- 7. Finished View -->
                <StackPanel x:Name="FinishedPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="🎉 Installation Completed!" Foreground="{StaticResource Success}" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock Text="TruckSim Widget has been successfully installed." Foreground="{StaticResource TextPrimary}" FontSize="14" Margin="0,0,0,24" />

                    <CheckBox Content="Launch TruckSim Widget now" IsChecked="{Binding LaunchAppAfter}" Margin="0,0,0,20" />
                </StackPanel>

                <!-- 8. Uninstall Confirm View -->
                <StackPanel x:Name="UninstallConfirmPanel" Visibility="Collapsed">
                    <TextBlock Text="Uninstall TruckSim Widget" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="Are you sure you want to uninstall TruckSim Widget?" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,16" />

                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BgBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="User Data Options:" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <RadioButton Content="Keep user data (Preserves settings, logs, and trip history)" IsChecked="{Binding KeepUserData}" Margin="0,0,0,10" />
                            <RadioButton Content="Delete everything (Removes all user data and settings)" IsChecked="{Binding KeepUserData, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6" />
                            <TextBlock Text="Note: Unknown/user files in application folder will always be preserved." Foreground="{StaticResource TextSecondary}" FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 9. Uninstalling Progress View -->
                <StackPanel x:Name="UninstallingPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Uninstalling TruckSim Widget..." Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />
                    <ProgressBar Value="{Binding ProgressPercentage}" Height="10" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondary}" FontSize="13" />
                </StackPanel>

                <!-- 10. Uninstall Finished View -->
                <StackPanel x:Name="UninstallFinishedPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Uninstallation Complete" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock Text="TruckSim Widget has been successfully removed from your computer." Foreground="{StaticResource TextSecondary}" FontSize="14" />
                </StackPanel>

                <!-- Error Message Bar -->
                <Border Background="#33E84141" BorderBrush="{StaticResource Error}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0" VerticalAlignment="Bottom" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFAAAA" TextWrapping="Wrap" FontSize="12" />
                </Border>
            </Grid>

            <!-- Navigation Footer -->
            <Grid Grid.Row="2" Background="{StaticResource BgCard}" Margin="0,1,0,0">
                <Border BorderBrush="{StaticResource BgBorder}" BorderThickness="0,1,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Button x:Name="BtnBack" Content="Back" Click="BtnBack_Click" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding CanGoBack}" Margin="0,0,10,0" />
                    <Button x:Name="BtnNext" Content="Next" Click="BtnNext_Click" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanGoNext}" Margin="0,0,10,0" />
                    <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
