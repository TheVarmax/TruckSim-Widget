<Window x:Class="ETSOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TruckSim Widget"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Style x:Key="InfoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="{DynamicResource InfoCardPadding}"/>
        </Style>

        <Style x:Key="GaugeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="{DynamicResource GaugeCardPadding}"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainBorder" Width="342" Margin="16"
            MouseEnter="MainBorder_MouseEnter" MouseMove="MainBorder_MouseMove" MouseLeave="MainBorder_MouseLeave">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UIScaleTransform" ScaleX="1.15" ScaleY="1.15"/>
        </Grid.LayoutTransform>
        <Grid x:Name="BackgroundsLayer">
            <Border x:Name="WindowBackgroundBorder" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="14" Opacity="{DynamicResource ShadowOpacity}" Direction="270" ShadowDepth="3"/>
                </Border.Effect>
            </Border>
            
            <Border Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Visibility="{Binding Visibility, ElementName=TopCardsGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="SimCardBg" Grid.Column="0" Style="{StaticResource InfoCardStyle}" Height="{Binding ActualHeight, ElementName=SimCard}"/>
                        <Border x:Name="StatusCardBg" Grid.Column="2" Style="{StaticResource InfoCardStyle}" Height="{Binding ActualHeight, ElementName=StatusCard}"/>
                    </Grid>
                    
                    <StackPanel Grid.Row="1" x:Name="CollapsibleSectionBgs" Margin="{Binding Margin, ElementName=CollapsibleSection}" Visibility="{Binding Visibility, ElementName=CollapsibleSection}">
                        <Grid Margin="{Binding Margin, ElementName=GameCardsGrid}" Visibility="{Binding Visibility, ElementName=GameCardsGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="GameCardBg" Grid.Column="0" Style="{StaticResource InfoCardStyle}" Height="{Binding ActualHeight, ElementName=GameCard}"/>
                            <Border x:Name="DistanceCardBg" Grid.Column="2" Style="{StaticResource InfoCardStyle}" Height="{Binding ActualHeight, ElementName=DistanceCard}"/>
                        </Grid>
                        
                        <Grid Margin="{Binding Margin, ElementName=RouteCard}" Visibility="{Binding Visibility, ElementName=RouteCard}">
                            <Border x:Name="RouteCardBg" Style="{StaticResource InfoCardStyle}" Height="{Binding ActualHeight, ElementName=RouteCard}"/>
                        </Grid>
                        
                        <Grid Margin="{Binding Margin, ElementName=BottomInfoGrid}" Visibility="{Binding Visibility, ElementName=BottomInfoGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CardBg1" Grid.Column="0" Style="{StaticResource GaugeCardStyle}" Height="{Binding ActualHeight, ElementName=BottomInfoGrid}"/>
                            <Border x:Name="CardBg2" Grid.Column="2" Style="{StaticResource GaugeCardStyle}" Height="{Binding ActualHeight, ElementName=BottomInfoGrid}"/>
                            <Border x:Name="CardBg3" Grid.Column="4" Style="{StaticResource GaugeCardStyle}" Height="{Binding ActualHeight, ElementName=BottomInfoGrid}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        


        <Border Padding="6">
        <Grid>
            <!-- Always-visible top hover trigger strip (used for floating header). Made 30px tall to catch fast movements -->
            <Rectangle x:Name="HeaderHoverTrigger" Fill="Transparent"
                       VerticalAlignment="Top" Height="30"
                       IsHitTestVisible="False" Panel.ZIndex="10"
                       MouseEnter="HeaderHover_Enter"/>

            <!-- INTRO OVERLAY -->
            <Grid x:Name="IntroOverlay" Panel.ZIndex="100" Visibility="Collapsed" ClipToBounds="True" Margin="-6">
                <Border x:Name="IntroOverlayBg" Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0">
                    <Border x:Name="IntroLogoBg" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="8" Margin="0,0,0,12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <Path x:Name="StartupLogo" Data="M20,8H17V4H3C1.89,4 1,4.89 1,6V17H3A3,3 0 0,0 6,20A3,3 0 0,0 9,17H15A3,3 0 0,0 18,20A3,3 0 0,0 21,17H23V12L20,8M6,18.5C5.17,18.5 4.5,17.83 4.5,17C4.5,16.17 5.17,15.5 6,15.5C6.83,15.5 7.5,16.17 7.5,17C7.5,17.83 6.83,18.5 6,18.5M18,18.5C17.17,18.5 16.5,17.83 16.5,17C16.5,16.17 17.17,15.5 18,15.5C18.83,15.5 19.5,16.17 19.5,17C19.5,17.83 18.83,18.5 18,18.5M17,12V9.5H19.5L21.47,12H17Z" Fill="{DynamicResource AccentColorBrush}" Stretch="Uniform" Width="36" Height="36" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="IntroText" Text="TRUCKSIM WIDGET" Foreground="{DynamicResource MainTextBrush}" FontSize="16" FontWeight="Heavy" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="MainUI">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ALWAYS VISIBLE TOP CARDS -->
                <Grid Grid.Row="0" x:Name="TopCardsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TB STATUS Card -->
                    <Grid x:Name="SimCard" Grid.Column="0">
                        <Grid Margin="{DynamicResource InfoCardPadding}">
                        <StackPanel x:Name="SimContent" Orientation="Horizontal">
                            <Border x:Name="SimIconBg" Background="{DynamicResource CardBackgroundHoverBrush}" CornerRadius="16" Width="32" Height="32">
                                <Ellipse x:Name="TbStatusDot" Width="8" Height="8" Fill="{DynamicResource AccentBrush_Sim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SimLabel" Text="TRUCKSBOOK" Foreground="{DynamicResource MainTextBrush}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="TbStatus" Text="TB • ONLINE" Foreground="{DynamicResource AccentBrush_Sim}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- STATUS Card -->
                    <Grid x:Name="StatusCard" Grid.Column="2">
                        <Grid Margin="{DynamicResource InfoCardPadding}">
                        <StackPanel x:Name="StatusContent" Orientation="Horizontal">
                            <Border x:Name="StatusIconBg" Background="{DynamicResource CardBackgroundHoverBrush}" CornerRadius="16" Width="32" Height="32">
                                <Path Data="M12 6v3l4-4-4-4v3c-4.42 0-8 3.58-8 8 0 1.57.46 3.03 1.24 4.26L6.7 14.8c-.45-.83-.7-1.79-.7-2.8 0-3.31 2.69-6 6-6zm6.76 1.74L17.3 9.2c.44.84.7 1.79.7 2.8 0 3.31-2.69 6-6 6v-3l-4 4 4 4v-3c4.42 0 8-3.58 8-8 0-1.57-.46-3.03-1.24-4.26z" Fill="{DynamicResource AccentBrush_Status}" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusLabel" Text="STATUS" Foreground="{DynamicResource MainTextBrush}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="StatusValue" Text="Wait for game..." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,-8,0"/>
                            </StackPanel>
                        </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- COLLAPSIBLE CARDS -->
                <StackPanel Grid.Row="1" x:Name="CollapsibleSection" Margin="0,6,0,0">
                    <Grid x:Name="GameCardsGrid" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- GAME Card -->
                    <Grid x:Name="GameCard" Grid.Column="0">
                        <Grid Margin="{DynamicResource InfoCardPadding}">
                            <StackPanel x:Name="GameContent" Orientation="Horizontal">
                                <Border x:Name="GameIconBg" Background="{DynamicResource CardBackgroundHoverBrush}" CornerRadius="16" Width="32" Height="32">
                                    <Path Data="M15 7.5V2H9v5.5l3 3 3-3zM7.5 9H2v6h5.5l3-3-3-3zM9 16.5V22h6v-5.5l-3-3-3 3zM16.5 9l-3 3 3 3H22V9h-5.5z" Fill="{DynamicResource AccentBrush_GameIcon}" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="GameLabel" Text="GAME" Foreground="{DynamicResource MainTextBrush}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="GameStatus" Text="ACTIVE" Foreground="{DynamicResource AccentBrush_GameText}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>

                        <!-- DISTANCE Card -->
                    <Grid x:Name="DistanceCard" Grid.Column="2">
                        <Grid Margin="{DynamicResource InfoCardPadding}">
                            <StackPanel x:Name="DistanceContent" Orientation="Horizontal">
                                <Border x:Name="DistanceIconBg" Background="{DynamicResource CardBackgroundHoverBrush}" CornerRadius="16" Width="32" Height="32">
                                    <Path Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" Fill="{DynamicResource AccentBrush_Distance}" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DistanceLabel" Text="DISTANCE" Foreground="{DynamicResource MainTextBrush}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="DistanceInfo" Text="0 / 0 km" Foreground="{DynamicResource AccentBrush_Distance}" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    </Grid>

            <!-- ROW 3: ROUTE CARD -->
                    <Grid x:Name="RouteCard" Margin="{DynamicResource CardMargin}">
                        <Grid x:Name="RouteContent" Margin="{DynamicResource InfoCardPadding}">
                <Grid>
                    <!-- SINGLE LINE LAYOUT -->
                    <StackPanel x:Name="RouteSingleLineGrid" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="RouteIconSingleBg" Background="{DynamicResource CardBackgroundHoverBrush}" CornerRadius="16" Width="32" Height="32">
                            <Path Data="M21 3L3 10.53v.98l6.84 2.65L12.48 21h.98L21 3z" Fill="{DynamicResource AccentBrush_Route}" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="RouteLabel" Text="ROUTE" Foreground="{DynamicResource MainTextBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        
                        <Border x:Name="RouteLine1" Width="2" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="10,2,10,2"/>
                        
                        <TextBlock x:Name="Route" Text="NOT DEFINED" Foreground="{DynamicResource MainTextBrush}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="220" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- MULTI LINE LAYOUT -->
                    <StackPanel x:Name="RouteMultiLineGrid" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,2,0,2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border x:Name="RouteIconMultiBg" Background="{DynamicResource CardBackgroundHoverBrush}" CornerRadius="12" Width="24" Height="24">
                                <Path Data="M21 3L3 10.53v.98l6.84 2.65L12.48 21h.98L21 3z" Fill="{DynamicResource AccentBrush_Route}" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="RouteLabelMulti" Text="ROUTE" Foreground="{DynamicResource MainTextBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        
                        <Border x:Name="RouteLine2" Height="2" Background="{DynamicResource CardBorderBrush}" CornerRadius="1" Margin="10,6,10,6"/>
                        
                        <TextBlock x:Name="RouteMulti" Text="NOT DEFINED" Foreground="{DynamicResource MainTextBrush}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
                        </Grid>
                    </Grid>

            <!-- ROW 4: BOTTOM GAUGES -->
            <Grid x:Name="BottomInfoGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SPEED Gauge -->
                    <Grid Grid.Column="0">
                        <Grid x:Name="Gauge1Content" Margin="{DynamicResource GaugeCardPadding}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="SpeedHeader" Grid.Row="0" Text="SPEED" Foreground="{DynamicResource MainTextBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>



                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock x:Name="SpeedValue" Text="0" Foreground="{DynamicResource AccentBrush_Speed}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="SpeedUnit" Grid.Row="2" Text="km/h" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                    </Grid>
                        </Grid>
                    </Grid>

                <!-- MAX Gauge -->
                    <Grid Grid.Column="2">
                        <Grid x:Name="Gauge2Content" Margin="{DynamicResource GaugeCardPadding}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="MaxHeader" Grid.Row="0" Text="MAX" Foreground="{DynamicResource MainTextBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>



                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock x:Name="MaxSpeedValue" Text="0" Foreground="{DynamicResource AccentBrush_Max}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="MaxUnit" Grid.Row="2" Text="km/h" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                    </Grid>
                        </Grid>
                    </Grid>

                <!-- TYPE -->
                    <Grid Grid.Column="4">
                        <Grid x:Name="Gauge3Content" Margin="{DynamicResource GaugeCardPadding}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TypeHeader" Grid.Row="0" Text="TYPE" Foreground="{DynamicResource MainTextBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>

                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock x:Name="DeliveryType" Text="N/A" Foreground="{DynamicResource AccentBrush_Type}" FontSize="20" FontWeight="Heavy" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Empty placeholder to match exact Row 2 layout of Speed/Max cards for perfect vertical alignment -->
                        <TextBlock Grid.Row="2" Text=" " FontSize="9" Margin="0,-2,0,0"/>
                    </Grid>
                        </Grid>
                    </Grid>
            </Grid>

        </StackPanel>
    </Grid>
    </Grid>
    </Border>
    </Grid>
</Window>
