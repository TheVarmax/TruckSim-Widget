<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>TruckSim_Widget</RootNamespace>
    <AssemblyName>TruckSim Widget</AssemblyName>
    <Version>1.6.4</Version>
    <AssemblyVersion>1.6.4.0</AssemblyVersion>
    <FileVersion>1.6.4.0</FileVersion>
    <InformationalVersion>1.6.4</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Updater\**" />
    <None Remove="Updater\**" />
    <Content Remove="Updater\**" />
    <EmbeddedResource Remove="Updater\**" />
    <Compile Remove="ElevatedHelper\**" />
    <None Remove="ElevatedHelper\**" />
    <Content Remove="ElevatedHelper\**" />
    <EmbeddedResource Remove="ElevatedHelper\**" />
    <Compile Remove="TruckSimWidgetSetup\**" />
    <None Remove="TruckSimWidgetSetup\**" />
    <Content Remove="TruckSimWidgetSetup\**" />
    <EmbeddedResource Remove="TruckSimWidgetSetup\**" />
    <Page Remove="TruckSimWidgetSetup\**" />
    <ApplicationDefinition Remove="TruckSimWidgetSetup\**" />
    <Compile Remove="*Tests\**;*.Tests\**" />
    <None Remove="*Tests\**;*.Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TruckSimWidget.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="favicon.ico" />
    <Content Include="Resources\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="plugin\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="SCSSdkClient">
      <HintPath>lib\SCSSdkClient.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MdXaml" Version="1.27.0" />
  </ItemGroup>
  <Target Name="BuildAndCopyHelpers" AfterTargets="Build;Publish">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\Updater\Updater.csproj&quot; -c $(Configuration) -r win-x64 --self-contained false -p:PublishSingleFile=true --nologo -v q" ContinueOnError="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Updater\bin\$(Configuration)\net8.0-windows\win-x64\publish\updater.exe" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Updater\bin\$(Configuration)\net8.0-windows\win-x64\publish\updater.exe" DestinationFolder="$(PublishDir)" Condition="'$(PublishDir)' != ''" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\ElevatedHelper\ElevatedHelper.csproj&quot; -c $(Configuration) -r win-x64 --self-contained true -p:PublishSingleFile=true -p:PublishTrimmed=true --nologo -v q" ContinueOnError="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\ElevatedHelper\bin\$(Configuration)\net8.0-windows\win-x64\publish\ElevatedHelper.exe" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\ElevatedHelper\bin\$(Configuration)\net8.0-windows\win-x64\publish\ElevatedHelper.exe" DestinationFolder="$(PublishDir)" Condition="'$(PublishDir)' != ''" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>
  <Target Name="BuildInstallerAfterPublish" AfterTargets="Publish" Condition="'$(BuildingInstaller)' != 'true' And '$(PublishDir)' != '' And '$(Configuration)' == 'Release'">
    <Error Condition="!Exists('$(PublishDir)updater.exe')" Text="Cannot package release: updater.exe is missing from the publish directory." />
    <Error Condition="!Exists('$(PublishDir)ElevatedHelper.exe')" Text="Cannot package release: ElevatedHelper.exe is missing from the publish directory." />
    <Message Text="================================================================" Importance="high" />
    <Message Text="[Auto-Build] Packaging and building TruckSimWidgetSetup..." Importance="high" />
    <Message Text="================================================================" Importance="high" />
    <Exec Command="powershell -ExecutionPolicy Bypass -NoProfile -File &quot;$(MSBuildProjectDirectory)\scripts\build-installer.ps1&quot; -Version &quot;$(Version)&quot; -Configuration &quot;$(Configuration)&quot; -PublishDir &quot;$(PublishDir.TrimEnd('\'))&quot; -SkipWidgetPublish" />
  </Target>
</Project>
